# Fresh, empty development database only. Replace placeholders privately.
# Existing installations must retain their original .env.local and biometric key.
DATABASE_URL="postgresql://OWNER:CHANGE_ME@DB_HOST/DB_NAME?sslmode=verify-full"
BETTER_AUTH_URL="http://localhost:3000"

# configure-auth.mjs generates APP_DATABASE_URL and BETTER_AUTH_SECRET privately.
# configure-biometric.mjs creates ATTENDAI_BIOMETRIC_KEY only for new enrollment setup.
# Never paste an existing key into this example or commit .env.local.
ATTENDAI_BIOMETRICS_ENABLED=false
ATTENDAI_VERIFICATION_TRIAL_ENABLED=false
