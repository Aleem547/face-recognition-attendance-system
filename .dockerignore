# Build application source paths; exclude configuration secrets, local model
# weights, Git history, installed dependencies and generated builds.
**
!Dockerfile
!.dockerignore
!deployment/
deployment/**
!deployment/next.config.mjs
!application/
application/**
!application/package.json
!application/package-lock.json
!application/next.config.ts
!application/tsconfig.json
!application/next-env.d.ts
!application/instrumentation.ts
!application/app/
!application/app/**
!application/components/
!application/components/**
!application/lib/
!application/lib/**
!application/public/
!application/public/**
!application/db/
!application/db/migrations/
!application/db/migrations/*.sql
!application/face-engine/
!application/face-engine/**
!application/scripts/
application/scripts/**
!application/scripts/*.mjs
!application/scripts/fetch-deployment-models.py
application/face-engine/models/
application/face-engine/pad/models/
application/face-engine/tests/
**/__pycache__/
**/.env*
**/*.env
**/*.onnx
**/*.jpeg
**/*.jpg
**/*.png
**/*.dump
**/*.key
**/*.pem
**/*.log
**/*.backup
**/node_modules/
**/.venv*/
**/.next*/
