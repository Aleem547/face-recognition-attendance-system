# Placeholder reference only. Put real values in the host's secret configuration.
# For local Compose, use scripts/export-container-env.mjs to make a private file.
APP_DATABASE_URL=postgresql://attendai_app:REPLACE_ME@DB_HOST/DB_NAME?sslmode=verify-full
BETTER_AUTH_URL=https://YOUR_DEPLOYMENT_HOST
BETTER_AUTH_SECRET=REPLACE_ME_WITH_THE_EXISTING_PRIVATE_SECRET
ATTENDAI_BIOMETRICS_ENABLED=false
ATTENDAI_VERIFICATION_TRIAL_ENABLED=false
# When enrollment is enabled, supply the ORIGINAL ATTENDAI_BIOMETRIC_KEY privately.
# DATABASE_URL (owner connection) must never be supplied to the web container.
